<Project Sdk="Aspire.AppHost.Sdk/13.2.2">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>eb53b053-b6b0-4511-a4ad-31ecfcbe9b3d</UserSecretsId>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Hosting.AppHost" />
      <PackageReference Include="Aspire.Hosting.Docker" />
      <PackageReference Include="Aspire.Hosting.JavaScript" />
      <PackageReference Include="Aspire.Hosting.Nats" />
      <PackageReference Include="Aspire.Hosting.PostgreSQL" />
      <PackageReference Include="CommunityToolkit.Aspire.Hosting.DbGate" />
      <PackageReference Include="CommunityToolkit.Aspire.Hosting.PostgreSQL.Extensions" />
      <PackageReference Include="DotNetEnv" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="configs/nats/certs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../Hosts/BackupService/BackupService.csproj" />
      <ProjectReference Include="../../Shared/Modules/DataBridge/DataBridge.csproj" />
      <ProjectReference Include="../../Shared/Modules/MediaProcessor/MediaProcessor.csproj" />
      <ProjectReference Include="../../Shared/Modules/Scheduler/Scheduler.csproj" />
      <ProjectReference Include="../../Shared/Modules/Api/WebAPI.csproj" />
      <ProjectReference Include="../../Shared/Modules/Worker/Worker.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="../../Shared/Hosting/AppHostCommon/*.cs" Link="Shared\%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
