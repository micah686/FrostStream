<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Shared/Modules/DataBridge/DataBridge.csproj" />
    <ProjectReference Include="../../Shared/Modules/MediaProcessor/MediaProcessor.csproj" />
    <ProjectReference Include="../../Shared/Modules/Scheduler/Scheduler.csproj" />
    <ProjectReference Include="../../Shared/Modules/Api/WebAPI.csproj" />
    <ProjectReference Include="../../Shared/Modules/Worker/Worker.csproj" />
  </ItemGroup>
  <Target Name="RemoveServiceSettingsFromBuild" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)" Condition="'%(Filename)' == 'appsettings' Or '%(Filename)' == 'appsettings.Development'" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)" Condition="'%(Filename)' == 'appsettings' Or '%(Filename)' == 'appsettings.Development'" />
      <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_SourceItemsToCopyToOutputDirectoryIfDifferent)" Condition="'%(Filename)' == 'appsettings' Or '%(Filename)' == 'appsettings.Development'" />
      <AllItemsFullPathWithTargetPath Remove="@(AllItemsFullPathWithTargetPath)" Condition="'%(Filename)' == 'appsettings' Or '%(Filename)' == 'appsettings.Development'" />
    </ItemGroup>
  </Target>
  <!-- Service-specific appsettings must not compete for the combined host's output path. -->
  <Target Name="RemoveServiceSettingsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Development.json'" />
    </ItemGroup>
  </Target>
</Project>
