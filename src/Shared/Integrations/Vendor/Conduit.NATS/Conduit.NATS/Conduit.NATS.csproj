<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Version>1.0.0</Version>
        <Authors>micah686</Authors>
        <Description>Thin NATS.Net facade for FrostStream: message bus, JetStream publish/consume, declarative topology, and a slim object-store passthrough.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Conduit.NATS.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NATS.Net" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
        <PackageReference Include="Vogen" />
    </ItemGroup>

</Project>
