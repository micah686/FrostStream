@page "/login"
@model LoginModel
@{
    ViewData["Title"] = "Operator sign-in";
}
<div class="login-card">
    <div class="feature-mark" aria-hidden="true">⌁</div>
    <h1>Operator sign-in</h1>
    <p class="lede">Unlock the console using your deployment’s restore token. A generated token is printed in the BackupService log at startup.</p>
    <form method="post" class="stack">
        <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
        <div class="field">
            <label asp-for="Token">Restore console token</label>
            <input asp-for="Token" type="password" autocomplete="current-password" maxlength="2048" required autofocus />
        </div>
        <button class="primary" type="submit">Unlock console <span aria-hidden="true">→</span></button>
    </form>
</div>
