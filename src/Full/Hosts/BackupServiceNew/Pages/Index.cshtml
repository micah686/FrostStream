@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Check readiness";
    ViewData["Step"] = 1;
    var observed = Model.Report.Checks.Any(check => check.State != CheckState.Pending);
}
<h1>Check readiness</h1>
<p class="lede">Stop FrostStream writers and PostgreSQL on the host. Leave BackupService running, then check the shared volumes and backup repository.</p>
<partial name="_Readiness" model="Model.Report" />
<div class="actions">
    <form method="get" data-readiness>
        <input type="hidden" name="run" value="true" />
        <button class="@(Model.Report.Ready ? "secondary" : "primary")" type="submit">@(observed ? "Run checks again" : "Run readiness checks")</button>
    </form>
    @if (Model.Report.Ready)
    {
        <a class="primary" asp-page="/Recovery/Choose">Choose recovery <span aria-hidden="true">→</span></a>
    }
</div>
@if (Model.Recent.Length > 0)
{
    <section class="recent">
        <h2>Recent restores</h2>
        @foreach (var job in Model.Recent)
        {
            <a class="recent-row" asp-page="/Recovery/Run" asp-route-id="@job.Id">
                <div><strong>@job.Plan.Backup.Label</strong><small>@RecoveryConsole.Time(job.CreatedAt.ToLocalTime())</small></div>
                <span class="pill">@RunStatus(job)</span>
            </a>
        }
    </section>
}
@functions {
    private static string RunStatus(RecoveryJob job) => job.Status == "failed" ? "Needs attention" :
        job.Stage switch { "database-validated" => "Database checked", "files-restored" => "Files restored", _ => job.Stage.Replace('-', ' ') };
}
