<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Shared/Integrations/Vendor/Conduit.NATS/Conduit.NATS/Conduit.NATS.csproj" />
    <ProjectReference Include="../../../Shared/Hosting/ServiceDefaults/ServiceDefaults.csproj" />
    <ProjectReference Include="../../../Shared/Core/Shared.csproj" />
    <ProjectReference Include="../../Infrastructure/Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Both hosts use the same OpenBao recovery artifact formats and checksums. -->
    <Compile Include="../BackupService/BackupEngine/Common/BackupJson.cs" Link="OpenBao/BackupJson.cs" />
    <Compile Include="../BackupService/BackupEngine/OpenBao/*.cs" Link="OpenBao/%(Filename)%(Extension)" />
    <Compile Include="../BackupService/BackupServiceOptions.cs" Link="BackupServiceOptions.cs" />
    <Compile Include="../BackupService/PgBackRest/OpenBaoPairing.cs" Link="OpenBao/OpenBaoPairing.cs" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="BackupBundleTests" /></ItemGroup>
</Project>
