<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FluentStorage" />
      <!-- NFSv3 client. LTRData's fork is the maintained DiscUtils line and the only one
           shipping a net10.0 target; it pulls in LTRData.DiscUtils.Core transitively. -->
      <PackageReference Include="LTRData.DiscUtils.Nfs" />
      <!-- SMB1 (CIFS) / SMB2 / SMB3 client. netstandard2.0, no OS mount required. -->
      <PackageReference Include="SMBLibrary" />
    </ItemGroup>

</Project>
