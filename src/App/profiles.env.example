# Copy outside version control and set FROSTSTREAM_ENV_FILE to its absolute path.
# Generate a profile with src/App/FullApp/generate-compose.sh or
# src/App/LiteApp/generate-compose.sh.
SINGLE_USER_MODE=false
FROSTSTREAM_PRODUCTION=false
FROSTSTREAM_DEV_TOOLS=false
ENABLE_HTTPS=false
LIVE_CHAT_ENABLED=false
TYPESENSE_API_KEY=replace-with-your-typesense-key
TYPESENSE_DATA_DIR=/data
TYPESENSE_ENABLE_CORS=false
# Full profile only. Replace before installation.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-postgres-password
OPENBAO_TOKEN=replace-with-your-openbao-token
AUTHENTIK_SECRET_KEY=replace-with-your-authentik-secret-key
AUTHENTIK_CLIENT_SECRET=replace-with-your-client-secret
AUTHENTIK_BOOTSTRAP_PASSWORD=replace-with-your-admin-password
OPENFGA_API_TOKEN=replace-with-your-openfga-token
BACKUP_RESTORE_UI_TOKEN=replace-with-your-restore-token
FROSTSTREAM_BACKUP_ROOT=./backups
# Optional ClickHouse integration (both profiles).
CLICKHOUSE_PASSWORD=replace-with-your-clickhouse-password
# Lite container paths. Keep beneath /data unless adding persistent mounts.
Persistence__Sqlite__Path=/data/frostreamlitedb
Backup__Directory=/data/backups
Secrets__Local__KeyRingPath=/data/frostreamlitedb.keys
AUTHENTIK_CLIENT_ID=froststream-frontend
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_TOKEN=replace-with-your-authentik-api-token
