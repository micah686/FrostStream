<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FluentStorage" Version="8.0.12" />
      <PackageReference Include="FluentStorage.AWS" Version="8.0.10" />
      <PackageReference Include="FluentStorage.Azure.Blobs" Version="8.0.10" />
      <PackageReference Include="FluentStorage.FTP" Version="8.0.11" />
      <PackageReference Include="FluentStorage.GCP" Version="8.0.10" />
      <PackageReference Include="FluentStorage.Minio" Version="8.0.10" />
      <PackageReference Include="FluentStorage.SFTP" Version="8.0.11" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
      <PackageReference Include="NodaTime" Version="3.3.3" />
      <!-- Version pin, not a code dependency. FluentStorage.FTP/SFTP depend on Polly 8.4.0, which
           asks for Polly.Core 8.4.0; this lifts it to 8.7.0. No source file here uses Polly. -->
      <PackageReference Include="Polly.Core" Version="8.7.0" />
      <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
      <PackageReference Include="VaultSharp" Version="1.17.5.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\StorageExtensions\StorageExtensions.csproj" />
      <ProjectReference Include="..\..\Libs\Conduit.NATS\Conduit.NATS\Conduit.NATS.csproj" />
      <ProjectReference Include="..\..\Libs\YtDlpSharpLib\YtDlpSharpLib\YtDlpSharpLib.csproj" />
    </ItemGroup>

</Project>
