<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FluentStorage" />
      <PackageReference Include="FluentStorage.AWS" />
      <PackageReference Include="FluentStorage.Azure.Blobs" />
      <PackageReference Include="FluentStorage.FTP" />
      <PackageReference Include="FluentStorage.GCP" />
      <PackageReference Include="FluentStorage.Minio" />
      <PackageReference Include="FluentStorage.SFTP" />
      <!-- FluentStorage.SFTP 8.0.11 references vulnerable SSH.NET 2025.1.0. Pin the
           fixed release until FluentStorage updates its transitive dependency. -->
      <PackageReference Include="SSH.NET" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
      <PackageReference Include="NodaTime" />
      <!-- Version pin, not a code dependency. FluentStorage.FTP/SFTP depend on Polly 8.4.0, which
           asks for Polly.Core 8.4.0; this lifts it to 8.7.0. No source file here uses Polly. -->
      <PackageReference Include="Polly.Core" />
      <PackageReference Include="System.IO.Hashing" />
      <PackageReference Include="VaultSharp" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\StorageExtensions\StorageExtensions.csproj" />
      <ProjectReference Include="..\..\Libs\Conduit.NATS\Conduit.NATS\Conduit.NATS.csproj" />
      <ProjectReference Include="..\..\Libs\YtDlpSharpLib\YtDlpSharpLib\YtDlpSharpLib.csproj" />
    </ItemGroup>

</Project>
