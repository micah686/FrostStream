<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>NU1901</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Libs\Conduit.NATS\Conduit.NATS\Conduit.NATS.csproj" />
      <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
      <ProjectReference Include="..\Shared\Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="LiveChat\Schema\*.sql" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="appsettings.Development.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="ClickHouse.Driver" Version="1.3.0" />
      <PackageReference Include="Cleipnir.Flows" Version="4.2.5" />
      <PackageReference Include="Cleipnir.Flows.PostgresSql" Version="4.2.5" />
      <PackageReference Include="FluentMigrator" Version="8.0.1" />
      <PackageReference Include="FluentMigrator.Runner.Core" Version="8.0.1" />
      <PackageReference Include="FluentMigrator.Runner.Postgres" Version="8.0.1" />
      <PackageReference Include="Npgsql.DependencyInjection" Version="10.0.3" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
      <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
      <PackageReference Include="FluentStorage" Version="8.0.12" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="10.0.3" />
      <PackageReference Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
      <!-- Version pin, not a code dependency. Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 asks for
           EF Relational 10.0.4; this lifts it to match the EF Core 10.0.10 that Shared pins, so the
           two halves of EF stay on the same patch level. -->
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
      <!-- Version pin, not a code dependency. The Polly.Extensions/Polly.RateLimiting that arrive
           via ServiceDefaults -> Microsoft.Extensions.Http.Resilience ask for Polly.Core 8.4.2, and
           FluentStorage.FTP/SFTP ask for 8.4.0; this lifts the whole graph to 8.7.0. No source file
           in this project uses Polly directly. -->
      <PackageReference Include="Polly.Core" Version="8.7.0" />
      <PackageReference Include="Quartz" Version="3.18.2" />
      <PackageReference Include="RecurPixel.Notify.Sdk" Version="0.3.0" />
      <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
      <PackageReference Include="Typesense" Version="8.5.0" />
    </ItemGroup>

</Project>
