<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>NU1901</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Libs\Conduit.NATS\Conduit.NATS\Conduit.NATS.csproj" />
      <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
      <ProjectReference Include="..\Shared\Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="LiveChat\Schema\*.sql" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="appsettings.Development.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="ClickHouse.Driver" />
      <PackageReference Include="Cleipnir.Flows" />
      <PackageReference Include="Cleipnir.Flows.PostgresSql" />
      <PackageReference Include="Cleipnir.ResilientFunctions.PostgreSQL" />
      <PackageReference Include="FluentMigrator" />
      <PackageReference Include="FluentMigrator.Runner.Core" />
      <PackageReference Include="FluentMigrator.Runner.Postgres" />
      <PackageReference Include="Npgsql.DependencyInjection" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
      <PackageReference Include="EFCore.NamingConventions" />
      <PackageReference Include="FluentStorage" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
      <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
      <!-- Version pin, not a code dependency. Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 asks for
           EF Relational 10.0.4; this lifts it to match the EF Core 10.0.10 that Shared pins, so the
           two halves of EF stay on the same patch level. -->
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
      <!-- Version pin, not a code dependency. The Polly.Extensions/Polly.RateLimiting that arrive
           via ServiceDefaults -> Microsoft.Extensions.Http.Resilience ask for Polly.Core 8.4.2, and
           FluentStorage.FTP/SFTP ask for 8.4.0; this lifts the whole graph to 8.7.0. No source file
           in this project uses Polly directly. -->
      <PackageReference Include="Polly.Core" />
      <PackageReference Include="Quartz" />
      <PackageReference Include="RecurPixel.Notify.Sdk" />
      <PackageReference Include="System.IO.Hashing" />
      <PackageReference Include="Typesense" />
    </ItemGroup>

</Project>
