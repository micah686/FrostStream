@page "/login"
@attribute [AllowAnonymous]

<div class="card" style="max-width: 26rem; margin: 4rem auto;">
    <h1>FrostStream Restore</h1>
    <p class="subtitle">Break-glass restore console. Enter the restore token
        (<code>BACKUP_RESTORE_UI_TOKEN</code> from the deployment's environment).</p>
    @if (Failed == 1)
    {
        <p class="error">That token was not accepted.</p>
    }
    <form method="post" action="/restore-ui/auth">
        <label for="token">Restore token</label>
        <input id="token" name="token" type="password" autocomplete="off" autofocus/>
        <div class="row">
            <button type="submit">Unlock</button>
        </div>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "failed")]
    public int? Failed { get; set; }
}
