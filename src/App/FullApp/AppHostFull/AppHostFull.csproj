<Project Sdk="Aspire.AppHost.Sdk/13.2.2">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>eb53b053-b6b0-4511-a4ad-31ecfcbe9b3d</UserSecretsId>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Hosting.AppHost" />
      <PackageReference Include="Aspire.Hosting.Docker" />
      <PackageReference Include="Aspire.Hosting.JavaScript" />
      <PackageReference Include="Aspire.Hosting.Nats" />
      <PackageReference Include="Aspire.Hosting.PostgreSQL" />
      <PackageReference Include="CommunityToolkit.Aspire.Hosting.DbGate" />
      <PackageReference Include="CommunityToolkit.Aspire.Hosting.PostgreSQL.Extensions" />
      <PackageReference Include="DotNetEnv" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="configs\nats\certs\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BackupService\BackupService.csproj" />
      <ProjectReference Include="..\..\SharedApp\DataBridge\DataBridge.csproj" />
      <ProjectReference Include="..\..\SharedApp\MediaProcessor\MediaProcessor.csproj" />
      <ProjectReference Include="..\..\SharedApp\Scheduler\Scheduler.csproj" />
      <ProjectReference Include="..\..\SharedApp\WebAPI\WebAPI.csproj" />
      <ProjectReference Include="..\..\SharedApp\Worker\Worker.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="..\..\SharedApp\AppHostCommon\*.cs" Link="Shared\%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
