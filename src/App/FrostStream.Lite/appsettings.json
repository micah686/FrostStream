{
  "ConnectionStrings": {
    "froststreamdb": ""
  },
  "Typesense": {
    "Url": "",
    "ApiKey": ""
  },
  "LiteSecrets": {
    "SecretsPath": "",
    "KeyDirectoryPath": "",
    "MaximumDocumentBytes": 1048576
  },
  "LiteExecution": {
    "MaximumConcurrency": 4,
    "DownloadConcurrency": 1,
    "WakeCapacity": 32,
    "PollInterval": "00:00:02",
    "OwnershipProbeInterval": "00:00:02"
  },
  "LiteAcquisition": {
    "YtDlpPath": "yt-dlp",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "TempPath": "/tmp/froststream-lite/acquisition",
    "IncomingPath": "/data/incoming",
    "StorageProbeTimeout": "00:00:10",
    "MinimumDelayBetweenYtDlpStarts": "00:00:03"
  },
  "LitePot": {
    "Enabled": false,
    "ProviderUrl": "",
    "ProxyBaseUrl": "http://127.0.0.1:5098/api/internal/pot/",
    "RequestTimeout": "00:00:30"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
