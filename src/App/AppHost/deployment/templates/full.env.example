# Sanitized Full deployment input template.
# Copy to a private file and pass it with --deployment-env. Leave secret values empty
# to let FrostStream generate and preserve them under deployment/resolved/<installation>.

FROSTSTREAM_INSTALLATION_NAME=froststream-full
FROSTSTREAM_PRODUCTION=false
FROSTSTREAM_DEV_TOOLS=false
FROSTSTREAM_STORAGE_ROOT=
FROSTSTREAM_BACKUP_ROOT=
FROSTSTREAM_OPENBAO_BOOTSTRAP_ROOT=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
OPENBAO_TOKEN=
TYPESENSE_API_KEY=
CLICKHOUSE_PASSWORD=
BACKUP_RESTORE_UI_TOKEN=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
OPENFGA_API_TOKEN=
NATS_PASSWORD=
NATS_UI_ADMIN_PASS=
NATS_UI_JWT_SECRET=

LIVE_CHAT_ENABLED=false
ENABLE_HTTPS=false
AUTHENTIK_AUTHORITY=
FRONTEND_PUBLIC_ORIGIN=http://localhost:25000

PORT_FRONTEND=25000
PORT_AUTHENTIK=25100
PORT_WEBAPI_HTTP=25200
PORT_WEBAPI_HTTPS=25210
PORT_SCHEDULER=25300
PORT_OPENBAO=25400
PORT_POSTGRES=25500
PORT_DBGATE=25600
PORT_NATS_UI=25700
PORT_OPENFGA_STUDIO=25800
PORT_BACKUP_RESTORE_UI=25900
