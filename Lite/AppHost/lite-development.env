# Lite: backend, frontend, POT provider; optionally ClickHouse.
FROSTSTREAM_DEV_TOOLS=false
LIVE_CHAT_ENABLED=false
BGUTIL_IMAGE_TAG=1.3.1
# Published frontend is loopback-only by default. Opting into trusted-LAN access
# grants every reachable client the same local Admin privileges.
LITE_TRUSTED_LAN=false
# Optional live-chat credentials, used only with LIVE_CHAT_ENABLED=true.
CLICKHOUSE_PASSWORD=froststream-dev-clickhouse-password
