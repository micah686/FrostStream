<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FrostStream.Persistence</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Shared.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Cleipnir.Flows" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
    <PackageReference Include="Quartz" />
    <EmbeddedResource Include="Persistence/Sqlite/Schema/*" LogicalName="DataBridge.Persistence.Sqlite.Schema.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
